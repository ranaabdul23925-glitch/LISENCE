# Reference only: this file is not loaded by the server and is not a deployable config.
# Inject real secrets from a secret manager; never commit them to Git.
POSTGRES_DATABASE_URL=
LICENSE_ADMIN_USERS_JSON=
LICENSE_SIGNING_PRIVATE_KEY=
# Optional rotation overlap: JSON array of old Ed25519 SPKI PEM public keys.
LICENSE_TRUSTED_PUBLIC_KEYS_JSON=

# Required. Supply valid JSON with owner-approved plans, prices, and currency.
# Every production plan must set graceDays to 7. Do not copy fictional prices.
LICENSE_PLANS_JSON=

# PostgreSQL is the default backend. The legacy SQLite service is available only
# through the explicit start:sqlite command and requires LICENSE_DATABASE_PATH
# to point to a dedicated local development database.

# Optional. Defaults: loopback in development, 0.0.0.0 in production; platform
# PORT (when set), otherwise 8787; and 7 offline-grace days. LICENSE_PORT
# overrides PORT.
# LICENSE_HOST=
LICENSE_OFFLINE_GRACE_DAYS=7
